DB_HOST=localhost
DB_PORT=3306
DB_USER=budian_user
DB_PASS=budian_password
DB_NAME=budian_allergen

NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-secret
JWT_EXPIRATION=7d
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=your-ml-api-key
# CORS: daftar origin web yang boleh akses (koma), wajib agar cookie anon_id terkirim.
# ALLOWED_ORIGINS=http://localhost:3000,https://domain-produksi.id
# Pepper tambahan untuk hash IP free detection (opsional; fallback ke JWT_SECRET).
# FREE_DETECTION_PEPPER=isi-string-acak-panjang
PORT=3001
# SMTP untuk email reset password (opsional di dev; tanpa ini token hanya di-log ke console).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_FROM=noreply@example.com
# SMTP_SECURE=false
# FRONTEND_URL=http://localhost:3000
# APP_MOBILE_SCHEME=budian
# EMAIL_VERIFICATION_TTL_HOURS=24
# REQUIRE_EMAIL_VERIFICATION=true
