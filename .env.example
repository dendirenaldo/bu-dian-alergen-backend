DB_HOST=localhost
DB_PORT=3306
# Nama kanonis (dipakai src/config/database.config.ts + config/config.js).
DB_USER=budian_user
DB_PASS=budian_password
DB_NAME=budian_allergen
# Alias kompatibilitas (opsional; dipakai bila DB_USER/DB_PASS/DB_NAME kosong).
# DB_USERNAME=
# DB_PASSWORD=
# DB_DATABASE=

NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-secret
JWT_EXPIRATION=7d
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=your-ml-api-key
# CORS: daftar origin web yang boleh akses (koma), wajib agar cookie anon_id terkirim.
# ALLOWED_ORIGINS=http://localhost:3000,https://domain-produksi.id
# Pepper tambahan untuk hash IP free detection (opsional; fallback ke JWT_SECRET).
# FREE_DETECTION_PEPPER=isi-string-acak-panjang
PORT=3001
