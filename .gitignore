# Runtime user uploads — JANGAN commit isi folder ini.
# Tanpa rule ini, `git clean -fd` menghapus file upload user.
# (Pakai `uploads/*` agar `!uploads/.gitkeep` tetap berlaku —
#  git tak bisa re-include bila parent dir-nya sendiri di-ignore.)
uploads/*
!uploads/.gitkeep
